      "html": "<a class=\"ds-action ds-solid\" href=\"#report\"><span class=\"ds-face\"><span class=\"ds-clip\"><span class=\"ds-label\">VIEW TRADING REPORT</span></span><svg class=\"ds-arrow\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></span></a>",
      "css": ".ds-action{position:relative;isolation:isolate;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:14px 19px;border:1px solid #858b96;border-radius:0;background:transparent;color:#f2f1ed;font:700 .78rem/1.5 Manrope,sans-serif;letter-spacing:.015em;text-decoration:none}.ds-face{display:inline-flex;align-items:center;gap:14px;transition:transform 140ms cubic-bezier(.22,1,.36,1);pointer-events:none}.ds-clip{overflow:hidden}.ds-label{display:inline-block;transition:transform 240ms cubic-bezier(.22,1,.36,1)}.ds-arrow{width:18px;height:18px;flex:0 0 18px;transition:transform 240ms cubic-bezier(.22,1,.36,1)}.ds-action:before{content:\"\";position:absolute;inset:0;z-index:-1;background:#242a33;transform:scaleX(0);transform-origin:left;transition:transform 240ms cubic-bezier(.22,1,.36,1)}.ds-action:focus-visible{outline:2px solid #c6cad1;outline-offset:5px}.ds-action:focus-visible .ds-face,.ds-action:focus-visible .ds-label,.ds-action:focus-visible .ds-arrow{transform:none;transition:none}.ds-action:active .ds-face{transform:scale(.98)}@media(hover:hover) and (pointer:fine){.ds-action:hover:before{transform:scaleX(1)}.ds-action:hover .ds-label{transform:translateY(-1px)}.ds-action:hover .ds-arrow{transform:translateX(3px)}}@media(prefers-reduced-motion:reduce){.ds-action:before{opacity:0;transition:none}.ds-face,.ds-label,.ds-arrow{transform:none!important;transition:none!important}}.ds-solid{background:#f2f1ed;color:#08090b}.ds-solid:before{background:#c6cad1}.ds-solid:focus-visible{outline-color:#f2f1ed}"
