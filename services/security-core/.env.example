# Names only. Nothing is automatically loaded by the local preview.
# Use separate high-entropy server-managed keys for each purpose.
SECURITY_CORE_CSRF_KEY=
SECURITY_CORE_RATE_KEY=
SECURITY_CORE_AUDIT_KEY=
# Optional dedicated root for the integrated administrator helper (otherwise derives
# separate purpose keys from the existing strong ADMIN_SESSION_SECRET).
SECURITY_CORE_ADMIN_KEY=
# Existing backend credentials remain in the hosting secret manager, never this public preview.
# Configure canonical HTTPS origins explicitly in the server integration factory.
