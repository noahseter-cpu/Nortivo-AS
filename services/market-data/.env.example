# This service is isolated from Nortivo's website and its production secrets.
DATA_PORT=4435
# Leave blank to generate a private local token at .local/access-token.
DATA_API_TOKEN=
# Optional explicit local SQLite paths; defaults are inside this package's .local/.
DATA_WAREHOUSE_PATH=
DATA_CACHE_PATH=

# OPTIONAL ingestion connectors, not required for own stored-data endpoints.
# Use a real operator contact email; never put an invented email here.
SEC_USER_AGENT=
FRED_API_KEY=
# Alpaca market-data credentials. Only the IEX feed is requested.
# No brokerage, OAuth trading, order placement, subscription or signup is performed.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
