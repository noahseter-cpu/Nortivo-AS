SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
RESEND_API_KEY=re_your-private-api-key
SUPPORT_FROM_EMAIL=Nortivo Support <support@nortivo.no>
ADMIN_NOTIFICATION_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=choose-a-long-private-password
ADMIN_SESSION_SECRET=choose-a-random-secret-with-at-least-32-characters

# New terminal is isolated from existing support/admin authentication.
# Apply supabase/terminal.sql to the existing project; reuse its server-only Supabase values above.
TERMINAL_SESSION_SECRET=choose-a-separate-random-secret-with-at-least-32-characters
TERMINAL_ORIGIN=https://nortivo.no
# Hosted public signup is disabled until the owner explicitly enables it. Guests and existing logins remain available.
TERMINAL_ALLOW_SIGNUP=false
# Optional provider. Keep every capability disabled until written commercial-display rights are confirmed.
FINNHUB_API_KEY=
TERMINAL_FINNHUB_COMMERCIAL_DISPLAY=false
TERMINAL_FINNHUB_CAPABILITIES=
# Set only to the actual quote delay covered by the approved subscription; blank means timing unverified.
TERMINAL_FINNHUB_DELAY_MINUTES=
# The legacy terminal remains paper-only. The additive subscription product below
# has separate gates and must never be activated by copying example placeholders.

# Subscription product: apply supabase/product.sql after terminal.sql, then enable.
PRODUCT_ENABLED=false
# Random 32-byte key encoded as base64url; generate privately, never commit a real value.
PRODUCT_ENCRYPTION_KEY=
# Independent random 32-byte key in standard base64 (with trailing =).
# This must differ from PRODUCT_ENCRYPTION_KEY; do not rotate over existing tokens blindly.
PRODUCT_BROKER_TOKEN_KEY=
# Optional account email sender; existing SUPPORT_FROM_EMAIL is the fallback.
AUTH_FROM_EMAIL=
# Comma-separated real terminal user UUIDs explicitly approved for operations.
PRODUCT_ADMIN_USER_IDS=

# Four pre-created recurring USD prices; annual amounts already include 20% saving.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=
STRIPE_PRICE_PORTFOLIO_MONTH=
STRIPE_PRICE_PORTFOLIO_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=

# Server-only OpenAI credential. No key is present or implied by this example.
OPENAI_API_KEY=
PRODUCT_OPENAI_MODEL=gpt-6-luna

# Read provider/cost documentation before buying contracts or enabling feeds.
TWELVE_DATA_API_KEY=
TRADING_ECONOMICS_API_KEY=
PRODUCT_PROVIDER_RIGHTS_JSON={}
PRODUCT_NEWS_EXCERPTS_APPROVED=false

# Live order transmission stays disabled until signed release evidence,
# broker approval, eligible account authorization, MFA and risk gates all pass.
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
PRODUCT_LIVE_TRANSMISSION_ENABLED=false
