# Documentation template only. Gradle reads the process environment;
# this file is not loaded automatically. Never put real credentials here.
# Leave ALL FOUR unset/empty for an unsigned Android release build.
# Set ALL FOUR in your build environment to sign with your own upload key.
ARC_UPLOAD_STORE_FILE=
ARC_UPLOAD_STORE_PASSWORD=
ARC_UPLOAD_KEY_ALIAS=
ARC_UPLOAD_KEY_PASSWORD=
